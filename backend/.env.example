NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://leadforge:leadforge@localhost:5433/leadforge?schema=public
REDIS_URL=redis://localhost:6379

CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWT_VERIFICATION_KEY=

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

OPENAI_API_KEY=sk-...

SMTP_VERIFY_FROM=verify@leadforge.ai
SMTP_VERIFY_TIMEOUT_MS=10000

S3_BUCKET=leadforge-exports
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public-facing URLs used in tracking pixels, unsubscribe links, and OAuth redirects
PUBLIC_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000

# Google OAuth for one-click Gmail connect (Sending Accounts → "Connect Gmail")
# Create an OAuth Client at https://console.cloud.google.com/apis/credentials
#   - Type: "Web application"
#   - Authorized redirect URI: http://localhost:4000/api/v1/sending-accounts/gmail/callback
# Scopes requested: https://mail.google.com/ (sending + IMAP read), openid email profile
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/sending-accounts/gmail/callback

# ─── Microsoft 365 / Outlook OAuth (one-click "Connect Outlook" button) ─────
# Register an Azure AD app at https://portal.azure.com → Azure Active Directory →
# App registrations → New registration:
#   - Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#   - Redirect URI (Web): http://localhost:4000/api/v1/sending-accounts/microsoft/callback
#   - API permissions: SMTP.Send, IMAP.AccessAsUser.All, offline_access, openid, email, profile
#   - Certificates & secrets → New client secret → copy the VALUE (not the ID)
# Set MICROSOFT_OAUTH_TENANT="common" to accept both personal and work accounts.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/sending-accounts/microsoft/callback
MICROSOFT_OAUTH_TENANT=common

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-5

# OpenRouter — free tier with DeepSeek/Qwen/Llama/Mistral/Gemma models
# Sign up at openrouter.ai → free $1 credits + many ":free" models with 20/min, 50/day limits
OPENROUTER_API_KEY=
# Default free model. Other good choices:
#   qwen/qwen3-235b-a22b:free
#   meta-llama/llama-3.3-70b-instruct:free
#   mistralai/mistral-small-3.1-24b-instruct:free
#   google/gemma-3-27b-it:free
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Groq — fastest free inference for chat agents (PRIMARY)
# Sign up at console.groq.com → free tier with rate-limited but fast inference
GROQ_API_KEY=
# Free models with tool-use support:
#   llama-3.3-70b-versatile         ← default, best for agents
#   deepseek-r1-distill-llama-70b   ← best reasoning
#   llama-3.1-8b-instant            ← fastest, lower quality
#   mixtral-8x7b-32768              ← strong + long context
#   gemma2-9b-it                    ← Google's small model
GROQ_MODEL=llama-3.3-70b-versatile
