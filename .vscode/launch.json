{
  // Debug configurations for VS Code. Pick any one from the Run-and-Debug
  // sidebar (Cmd+Shift+D) and press F5 to start.
  //
  // The compounds at the bottom let you launch backend + workers + frontend
  // together with a single click — useful when reproducing a full-stack bug.
  "version": "0.2.0",
  "configurations": [
    // ─── Backend API ────────────────────────────────────────────────────────
    {
      "name": "Backend: API server (tsx watch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch", "src/server.ts"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },

    // ─── Backend workers (BullMQ) ───────────────────────────────────────────
    {
      "name": "Backend: BullMQ workers (tsx watch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch", "src/workers/index.ts"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },

    // ─── Frontend (Next.js) — both server-side and client-side ─────────────
    {
      "name": "Frontend: Next.js (server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "ready - started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Frontend: Chrome (client-side)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/src"
    },

    // ─── Attach to a running process (for prod-mode local debug) ───────────
    {
      "name": "Attach to Node (any process)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ],

  // ─── One-click "full stack" launchers ───────────────────────────────────
  "compounds": [
    {
      "name": "Full stack (API + workers + frontend)",
      "configurations": [
        "Backend: API server (tsx watch)",
        "Backend: BullMQ workers (tsx watch)",
        "Frontend: Next.js (server)"
      ],
      "stopAll": true
    },
    {
      "name": "Backend only (API + workers)",
      "configurations": [
        "Backend: API server (tsx watch)",
        "Backend: BullMQ workers (tsx watch)"
      ],
      "stopAll": true
    }
  ]
}
